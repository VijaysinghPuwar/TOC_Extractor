<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Plain black and white. Structure comes from spacing, weight and thin
       rules, not from colour: no gradients, no tints, no shadows. -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Ink" Color="#000000" />
          <SolidColorBrush x:Key="Paper" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Muted" Color="#5C5C5C" />
          <SolidColorBrush x:Key="Rule" Color="#E2E2E2" />
          <SolidColorBrush x:Key="Wash" Color="#F7F7F7" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Ink" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Paper" Color="#0A0A0A" />
          <SolidColorBrush x:Key="Muted" Color="#A6A6A6" />
          <SolidColorBrush x:Key="Rule" Color="#2B2B2B" />
          <SolidColorBrush x:Key="Wash" Color="#121212" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#0A0A0A" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#0A0A0A" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#0A0A0A" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Paper}" />
    <Setter Property="FontFamily" Value="fonts:Inter#Inter" />
  </Style>

  <!-- Type -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Margin" Value="0,18,0,8" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.big">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Cards: a thin rule, no fill in light mode beyond paper -->
  <Style Selector="Border.card">
    <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="Background" Value="{DynamicResource Paper}" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Background" Value="{DynamicResource Paper}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource Paper}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Muted}" />
    <Setter Property="Foreground" Value="{DynamicResource Paper}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rule}" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <!-- Panel tabs: underlined when selected -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="4,8" />
    <Setter Property="Margin" Value="0,0,20,0" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tab.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <!-- The step strip -->
  <Style Selector="Border.step">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.step > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="Border.step.current">
    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Border.step.current > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Border.step.done">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Border.step.done > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Paper}" />
  </Style>
  <Style Selector="TextBlock.steplabel">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="TextBlock.steplabel.current">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource Rule}" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- Chapter list rows -->
  <Style Selector="ListBox.chapters ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
  </Style>
</Styles>
